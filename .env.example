# Copy this file to `.env.local` and fill in the values.
# NEVER commit .env.local — it holds your secret key. (.gitignore already skips it.)
#
# Where to find these: Supabase dashboard → your project → Project Settings → API Keys
#   (and the Project URL under Project Settings → Data API)

# Safe to share with browsers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SECRET. Server only. Lets the website place orders on students' behalf and
# lets `npm run create-admin` create your login.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Any long random string. Used to scramble device IP addresses before they're
# stored for prank-order rate limiting. Make one with:  openssl rand -hex 32
IP_HASH_SALT=replace-with-a-long-random-string
