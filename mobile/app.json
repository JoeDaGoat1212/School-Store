{
  "expo": {
    "name": "Firebirds Nest",
    "slug": "firebirds-nest-staff",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "firebirdsnest",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17191c"
    },
    "ios": {
      "bundleIdentifier": "com.firebirdsnest.staff",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.firebirdsnest.staff",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://school-store-steel.vercel.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera takes the restock photos after each shift.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#FF5A1F"
        }
      ],
      "expo-background-task"
    ]
  }
}
